# ==========================================================================
# Multi-User RAG Platform — backend environment variables
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ==========================================================================

# --- Application ---
PROJECT_NAME=Multi-User RAG Platform
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (Streamlit frontend).
CORS_ORIGINS=http://localhost:8501

# --- Database (asyncpg) ---
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_platform
DB_ECHO=false

# --- Auth / JWT ---
# MUST be overridden in any non-local environment (>= 32 random bytes).
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM provider (switch via LLM_PROVIDER: groq|openai|gemini|ollama) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval / RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=160
TOP_K_VECTOR=20
TOP_K_BM25=20
RRF_K=60
RERANK_ENABLED=true
RERANK_TOP_N=6
SIMILARITY_THRESHOLD=0.35
CONTEXT_CHUNKS=6
HISTORY_TURNS=6

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=25
MAX_KB_SIZE_MB=200
ALLOWED_FILE_TYPES=pdf,docx,txt,md

# --- Storage (local | s3) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
S3_BUCKET=
S3_REGION=
# Optional: S3-compatible endpoint (leave empty for AWS S3).
S3_ENDPOINT_URL=
# Optional: explicit credentials (prefer an IAM role / instance profile in prod).
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Object key prefix, e.g. uploads/<user_id>/<document_id>/<filename>.
S3_PREFIX=uploads

# --- Chroma vector DB ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./data/chroma

# --- Rate limiting (per user) ---
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=10
